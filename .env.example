# HexHound environment configuration
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
#
# Nothing is pre-filled on purpose: you choose the provider, model and key.
# Easiest way to get a working .env:  hexhound setup
# List all built-in presets:           hexhound providers

# ============================================================
# 1) Model provider  (REQUIRED - one of the 12 presets, or `custom`)
# ============================================================
# Presets: deepseek | openai | anthropic | gemini | qwen | moonshot
#          zhipu | siliconflow | openrouter | ollama | vllm | custom
LLM_PROVIDER=

# Model name. Leave empty to use the preset's recommended model.
# `hexhound providers` prints the common model names per provider.
LLM_MODEL=

# API base URL. Leave empty for the preset's official endpoint;
# fill it in for `custom` (gateways, corporate proxies, self-hosted).
LLM_BASE_URL=

# Shared API key, used when no provider-specific key below is set.
# Local providers (ollama / vllm) and `custom` may leave this empty.
LLM_API_KEY=

# Per-provider keys (optional; these take precedence over LLM_API_KEY)
# PROVIDER_DEEPSEEK_API_KEY=
# PROVIDER_OPENAI_API_KEY=
# PROVIDER_QWEN_API_KEY=

# ============================================================
# 2) Authorized scope  (REQUIRED - only these hosts are ever contacted)
# ============================================================
# Comma-separated hostnames, no scheme, no path.
ALLOWED_HOSTS=127.0.0.1,localhost

# ============================================================
# 3) Multi-agent orchestration
# ============================================================
# MAX_TASKS   : max sub-tasks per run
# TASK_STEPS  : step budget per sub-task (12 is safer for broad recon)
# PARALLEL    : concurrent sub-agents (1 = serial, cheaper and gentler)
MAX_TASKS=6
TASK_STEPS=10
PARALLEL=3
# USE_SWARM=0 falls back to the single-agent ReAct loop (v0.1 behaviour)
USE_SWARM=1

# ============================================================
# 4) Per-role models  (optional)
# ============================================================
# Give the planner/verifier a stronger model and the bulk workers a cheaper one.
# Any role left empty simply follows LLM_MODEL above.
# LLM_PLANNER_MODEL=
# LLM_RECON_MODEL=
# LLM_INJECTION_MODEL=
# LLM_AUTH_MODEL=
# LLM_VERIFY_MODEL=

# ============================================================
# 5) Budget and rate limits  (0 = unlimited)
# ============================================================
# Crossing a budget stops the run gracefully and records the reason in the report.
MAX_COST=0
MAX_TOKENS=0
MAX_LLM_CALLS=0
MAX_TOOL_CALLS=0
MAX_SECONDS=0
# Minimum gap between HTTP requests, in seconds. Use 0.2-1 against production.
RATE_LIMIT=0
TEMPERATURE=0.2
# DeepSeek only: leave blank for server default, or low / high / max.
# Thinking mode ignores TEMPERATURE. No effort parameter is sent to other providers.
LLM_REASONING_EFFORT=

# ============================================================
# 6) Misc
# ============================================================
MAX_STEPS=30
REQUEST_TIMEOUT=10

# ============================================================
# 7) Optional: vision model for the image-analysis panel
# ============================================================
# Any OpenAI-compatible multimodal endpoint.
# VISION_API_KEY=
# VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VISION_MODEL=qwen3-vl-235b-a22b-thinking
