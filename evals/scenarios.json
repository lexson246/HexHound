{
  "version": 1,
  "target": "http://127.0.0.1:5000",
  "note": "标准答案来自 vulnlab 的**已知漏洞**（每个都能被 tools/verify_lab_*.sh 手工复现）。expected 取值：signal=引擎应当命中；none=应当安静（误报判据）；reflection_only=字符串层面确实是反射，但**不是可利用的 XSS**（只有浏览器层能分辨）——引擎命中它不算错，Agent 把它记成 XSS 才算误报。",
  "scenarios": [
    {
      "id": "sqli-login",
      "name": "/login 错误型 SQL 注入",
      "endpoint": "/login",
      "method": "POST",
      "location": "form",
      "param": "username",
      "category": "sqli",
      "sample": {"username": "alice", "password": "x"},
      "expected": "signal",
      "ground_truth": "SQL注入",
      "note": "payload 会让 sqlite 报错并回显，verify_lab 手工复现过"
    },
    {
      "id": "xss-reflect",
      "name": "/reflect 反射型 XSS（HTML 上下文，真的会执行）",
      "endpoint": "/reflect",
      "method": "GET",
      "location": "query",
      "param": "name",
      "category": "xss",
      "sample": {"name": "hello"},
      "expected": "signal",
      "ground_truth": "反射型XSS"
    },
    {
      "id": "ssti-name",
      "name": "/ssti 模板注入",
      "endpoint": "/ssti",
      "method": "GET",
      "location": "query",
      "param": "name",
      "category": "ssti",
      "sample": {"name": "world"},
      "expected": "signal",
      "ground_truth": "SSTI",
      "note": "{{7*7}} 被求值成 49"
    },
    {
      "id": "cmdi-ping",
      "name": "/ping 命令注入",
      "endpoint": "/ping",
      "method": "GET",
      "location": "query",
      "param": "ip",
      "category": "cmd",
      "sample": {"ip": "127.0.0.1"},
      "expected": "signal",
      "ground_truth": "命令注入"
    },
    {
      "id": "lfi-file",
      "name": "/file 目录遍历（任意文件读取）",
      "endpoint": "/file",
      "method": "GET",
      "location": "query",
      "param": "path",
      "category": "path",
      "sample": {"path": "secret.txt"},
      "expected": "signal",
      "ground_truth": "任意文件读取",
      "note": "payload 读 /etc/passwd 或相对路径的 secret.txt"
    },
    {
      "id": "ssrf-fetch",
      "name": "/fetch 服务端请求伪造",
      "endpoint": "/fetch",
      "method": "GET",
      "location": "query",
      "param": "url",
      "category": "ssrf",
      "sample": {"url": "http://127.0.0.1:5000/"},
      "expected": "signal",
      "ground_truth": "SSRF"
    },
    {
      "id": "idor-order",
      "name": "/api/order 越权读取他人订单",
      "endpoint": "/api/order",
      "method": "GET",
      "location": "query",
      "param": "order_id",
      "category": "auth",
      "sample": {"order_id": "1001"},
      "expected": "signal",
      "ground_truth": "越权访问",
      "note": "匿名即可读到 owner/地址/手机号；引擎层用 http_request 判定"
    },
    {
      "id": "unauth-users",
      "name": "/api/users 未授权访问（返回个人信息）",
      "endpoint": "/api/users",
      "method": "GET",
      "location": "query",
      "param": "",
      "category": "auth",
      "sample": {},
      "expected": "signal",
      "ground_truth": "未授权访问",
      "note": "不带任何凭据即可读到 PII"
    },
    {
      "id": "reflect-csp",
      "name": "/reflect-csp 反射但被 CSP 拦住（不可执行）",
      "endpoint": "/reflect-csp",
      "method": "GET",
      "location": "query",
      "param": "name",
      "category": "xss",
      "sample": {"name": "hello"},
      "expected": "reflection_only",
      "ground_truth": "（不是漏洞）",
      "note": "payload 原样回显在 HTML 正文里，但 CSP 禁止内联脚本执行；只有浏览器能判定"
    },
    {
      "id": "reflect-dom",
      "name": "/reflect-dom 进了 DOM 但被转义（不可执行）",
      "endpoint": "/reflect-dom",
      "method": "GET",
      "location": "query",
      "param": "name",
      "category": "xss",
      "sample": {"name": "hello"},
      "expected": "none",
      "ground_truth": "（不是漏洞）",
      "note": "escape() 之后落在 textarea 里；字符串层面也不该命中（payload 不在响应体里）"
    },
    {
      "id": "decoy-static",
      "name": "/static/app.js 静态资源（参数无效）",
      "endpoint": "/static/app.js",
      "method": "GET",
      "location": "query",
      "param": "x",
      "category": "sqli",
      "sample": {"x": "1"},
      "expected": "none",
      "ground_truth": "（不是漏洞）"
    },
    {
      "id": "decoy-root",
      "name": "/ 首页（参数被忽略）",
      "endpoint": "/",
      "method": "GET",
      "location": "query",
      "param": "q",
      "category": "sqli",
      "sample": {"q": "1"},
      "expected": "none",
      "ground_truth": "（不是漏洞）"
    }
  ]
}
